{
    "name": "@ostro/container",
    "version": "2.0.0-alpha.1",
    "description": "Container module for OstroJS",
    "main": "build/application.js",
    "scripts": {
        "test": "npx c8 npx jest",
        "build": "tsc -p tsconfig.build.json && node scripts/build.js",
        "prepublishOnly": "npm run build",
        "clean": "rm -rf build coverage"
    },
    "dependencies": {
        "@ostro/contracts": "^2.0.0-alpha.1",
        "@ostro/support": "^2.0.0-alpha.1",
        "lodash.set": "^4.3.2"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "keywords": [
        "container",
        "application container",
        "framework container"
    ],
    "author": "amar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/container.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/container/issues"
    },
    "homepage": "https://github.com/ostrojs/container#readme",
    "types": "build/application.d.ts",
    "files": [
        "build"
    ],
    "exports": {
        ".": {
            "types": "./build/application.d.ts",
            "default": "./build/application.js"
        },
        "./*": {
            "types": "./build/*.d.ts",
            "default": "./build/*.js"
        }
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "typescript": "^5.8.0"
    },
    "overrides": {
        "sprintf-js": "^1.1.3",
        "braces": "^3.0.3",
        "argparse": "^2.0.1",
        "js-yaml": "^4.1.0"
    }
}
